

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=Kivo
LOG_LEVEL=debug

CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── JWT (backend session tokens) ─────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=kivo.api
JWT_AUDIENCE=kivo.app


FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escape newlines in the private key as \n
FIREBASE_PRIVATE_KEY=

# ── Redis (cache + BullMQ) ───────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# Optional single-URL form (overrides the host/port fields above)
REDIS_URL=

# ── BullMQ ───────────────────────────────────────────────────
BULLMQ_PREFIX=kivo
BULLMQ_CONCURRENCY=10

# ── Cloudflare R2 (S3-compatible object storage) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kivo-uploads
R2_PUBLIC_BASE_URL=https://cdn.kivo.app
R2_PRESIGN_EXPIRES_IN=900

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
